{
  "neoconf": {
    "live_reload": true,
    "filetype_jsonc": true,
    "plugins": {
      "lua_ls": {
        "enabled": true
      },
      "jsonls": {
        "enabled": true
      }
    }
  },
  "lspconfig": {
    "lua_ls": {
      "Lua.hint.enable": true,
      "Lua.hint.paramName": "All",
      "Lua.hint.arrayIndex": "Disable",
      "Lua.hint.paramType": false,
      "Lua.codeLens.enable": true,
      "Lua.semantic.enable": true,
      "Lua.typeFormat.config": {
        "format_line": "true",
        "auto_complete_end": "true"
      },
      "Lua.hover.enumsLimit": 5
    }
  }
}
